# Backend configuration. Copy to backend/.env and fill in real values.
PORT=3000
HOST=0.0.0.0
# Exact browser origin(s), comma-separated. Example: https://al-business.github.io
ALLOWED_ORIGINS=https://al-business.github.io
# OpenAI-compatible API URL (Groq: https://api.groq.com/openai/v1; Gemini: https://generativelanguage.googleapis.com/v1beta/openai)
AI_BASE_URL=https://api.groq.com/openai/v1
AI_API_KEY=replace_with_provider_key
AI_MODEL=replace_with_model_name
AI_MAX_TOKENS=900
AI_TIMEOUT_MS=60000
